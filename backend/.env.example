# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL (Supabase) ─────────────────────────────────────────────────────
# Supabase 대시보드 → Settings → Database → Connection string (URI) 에서 복사
# 예: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Upstash 대시보드 → Redis → Connect → ioredis 탭에서 URL 복사
# 예: rediss://default:PASSWORD@HOST:PORT
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# ── Base L2 (Sepolia Testnet) ─────────────────────────────────────────────────
BASE_RPC_URL=https://sepolia.base.org

# ── Wallet (운영자 계정) ──────────────────────────────────────────────────────
# ⚠️  절대 Git에 커밋하지 마세요!
OPERATOR_PRIVATE_KEY=0x...
OPERATOR_ADDRESS=0x...
TREASURY_PRIVATE_KEY=0x...
TREASURY_ADDRESS=0x...

# ── Contracts ─────────────────────────────────────────────────────────────────
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ESCROW_CONTRACT_ADDRESS=0x...

# ── Perun ─────────────────────────────────────────────────────────────────────
PERUN_GRPC_HOST=localhost
PERUN_GRPC_PORT=8080

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
