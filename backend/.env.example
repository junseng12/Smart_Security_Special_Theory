# ── 블록체인 ──────────────────────────────────────────────
BASE_RPC_URL=https://sepolia.base.org
OPERATOR_PRIVATE_KEY=your_64char_hex_private_key_without_0x
OPERATOR_ADDRESS=0x1E506DE9EdEB3F7c3C1f39Edc5c38625944345C7
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ESCROW_CONTRACT_ADDRESS=0xf6B7d5c6C7a907D906419125B9dD2EeeCb26De3c

# ── 데이터베이스 (Supabase) ───────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# ── Perun (없으면 mock 모드) ──────────────────────────────
# PERUN_GRPC_HOST=localhost
# PERUN_GRPC_PORT=8080

# ── 서버 ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── CORS (Base44 프론트 URL 넣기) ───────────────────────────────
ALLOWED_ORIGINS=https://app.base44.com,https://YOUR_APP.base44.com
