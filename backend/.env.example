# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Base L2 Network
# ─────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
# Base Sepolia (testnet)
# BASE_RPC_URL=https://sepolia.base.org
# BASE_CHAIN_ID=84532

# USDC on Base (native Circle deployment)
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Operator wallet (treasury / signing)
OPERATOR_PRIVATE_KEY=your_operator_private_key_here
OPERATOR_ADDRESS=your_operator_address_here

# ─────────────────────────────────────────────
# Perun Node (Go process)
# ─────────────────────────────────────────────
PERUN_GRPC_HOST=localhost
PERUN_GRPC_PORT=8080
PERUN_REST_FALLBACK_URL=http://localhost:8081

# Perun on-chain contracts (deploy these to Base first)
PERUN_ADJUDICATOR_ADDRESS=0xYourAdjudicatorAddress
PERUN_ASSET_HOLDER_ADDRESS=0xYourAssetHolderAddress

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────
# PostgreSQL (persistent channel records)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/smartcity_payments

# ─────────────────────────────────────────────
# Watchtower
# ─────────────────────────────────────────────
WATCHTOWER_POLL_INTERVAL_MS=30000
WATCHTOWER_CHALLENGE_BUFFER_BLOCKS=10

# ─────────────────────────────────────────────
# Treasury (for forced refunds)
# ─────────────────────────────────────────────
TREASURY_PRIVATE_KEY=your_treasury_private_key_here
TREASURY_ADDRESS=your_treasury_address_here

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
API_SECRET_KEY=your_api_secret_for_hmac_or_jwt
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
